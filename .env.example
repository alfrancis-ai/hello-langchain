# Azure OpenAI settings from ITF-CostOptAgenticAgent/fastapi-backend.
# Copy to .env before adding credentials. Never commit your .env file.
# main-langgraph.py loads .env and authenticates with the API key; no az login needed.
AZURE_OPENAI_ENDPOINT=https://journofoundry-4259-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

LLM_PROVIDER=portkey
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_MODEL=@azure-openai-lab/gpt-5.4-mini